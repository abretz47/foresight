# Foresight – environment variable reference
#
# Copy this file to .env.local (git-ignored) and set the values you need.
# Never commit secrets or .env.local.
#
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
# All others are server-side / build-time only.

# ── Feature flags ──────────────────────────────────────────────────────────
#
# Set to "true" to enable the PiTrac launch-monitor WebSocket integration.
# Leave unset (or set to anything other than "true") to keep the feature
# hidden in production builds.
#
# EXPO_PUBLIC_ENABLE_PITRAC=true

# ── Supabase (optional cloud sync) ────────────────────────────────────────
#
# EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ── Training Modules (paid content) ───────────────────────────────────────
#
# Base URL of the deployed web app — used in PurchasePromptModal to direct
# native users to the purchase page.
# EXPO_PUBLIC_WEB_APP_URL=https://app.foresight.example.com
#
# Stripe publishable key (web client only).
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
#
# Stripe Price ID for the platform access product (grants paid-content-user).
# EXPO_PUBLIC_STRIPE_PLATFORM_PRICE_ID=price_...
#
# --- Edge Function environment (set in Supabase dashboard, not in .env.local) ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PLATFORM_PRICE_ID=price_...
# WEB_APP_URL=https://app.foresight.example.com
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   (auto-injected by Supabase Edge Functions)
#
# --- Proprietary CI builds only ---
# NPM_TOKEN=<private-registry-token>
